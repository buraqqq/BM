# ==========================================================
# B&M Vourla — Environment Variables (örnek dosya)
# Bu dosyayı .env olarak kopyalayın ve gerçek değerlerle doldurun.
# .env dosyası ASLA git'e eklenmez (bkz. .gitignore).
# ==========================================================

# --- Database ---
# FAZ 1 varsayılanı: yerel SQLite dosyası (sıfır altyapı, kolay yedekleme).
# Serverless/Vercel gibi kalıcı disk sunmayan bir platforma taşınırsa
# bu satırı hosted Postgres (ör. Neon, Supabase) veya libSQL/Turso ile değiştirin.
# Prisma datasource'u tek satır değişikliğiyle bu geçişi destekler.
DATABASE_URL="file:./dev.db"

# --- NextAuth ---
# Üretim/geliştirmede kendi rastgele değerinizi üretin: `openssl rand -base64 32`
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_A_RANDOM_32BYTE_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# --- İlk admin kullanıcısı (yalnızca seed script'i tarafından, tek seferlik kullanılır) ---
# Seed çalıştıktan sonra bu değerleri .env'den silin ve admin panelinden şifreyi değiştirin.
ADMIN_SEED_EMAIL="admin@bmvourla.com"
ADMIN_SEED_PASSWORD="CHANGE_ME_STRONG_TEMP_PASSWORD"

# --- Node ortamı ---
NODE_ENV="development"

# --- Rate limiting (login brute-force koruması) ---
LOGIN_MAX_ATTEMPTS="5"
LOGIN_WINDOW_MINUTES="15"

# --- Storage (FAZ 1: yerel dosya sistemi; ileride S3 uyumlu depolamaya geçiş için ayrılmıştır) ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./public/uploads"
# S3 uyumlu depolamaya geçişte (FAZ 2+):
# STORAGE_DRIVER="s3"
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# --- Public site tabanlı URL (server component'lerin kendi API'sini
# çağırabilmesi için; production'da gerçek domain ile değiştirin) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Notification / Email Config (FAZ 10) ---
# E-posta bildirim servisi provider/adaptörü (bkz. src/lib/email-service.ts).
# CONSOLE: stdout'a yazar (geliştirme, varsayılan; gerçek teslimat yok).
# MOCK   : hiçbir şey yapmaz (test ortamı, deterministik no-op).
# RESEND : Resend REST API'ye gerçek e-posta gönderir (RESEND_API_KEY gerekir).
# EMAIL_PROVIDER: CONSOLE | MOCK | RESEND (Default: CONSOLE)
EMAIL_PROVIDER=CONSOLE
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# --- Cron / servis-token (FAZ 13) ---
# Harici cron servislerinin /api/cron/alerts ucunu çağırabilmesi için.
# Üretimde güçlü, rastgele bir değer üretin: openssl rand -base64 32
# AYARLANMAZSA /api/cron/alerts 503 döner (fail-closed) — açıkta uç bırakılmaz.
CRON_SECRET=
