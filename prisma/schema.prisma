// ==========================================================
// B&M Vourla — Prisma Schema (FAZ 1)
// Veritabanı: SQLite (bkz. .env.example ve docs/database.md için
// hosted Postgres/libSQL'e geçiş notları)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------
// Kimlik & Yetkilendirme
// ----------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  // SQLite native enum desteklemez; izin verilen değerler uygulama katmanında
  // (src/lib/enums.ts + zod) zorunlu kılınır: SUPER_ADMIN | ADMIN | STAFF
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  loginAttempts  LoginAttempt[]
  auditLogs      AuditLog[]
  priceChanges   PriceHistory[]
  inventoryMoves InventoryMovement[]
  importJobs     ImportJob[]

  @@map("admin_users")
}

// Rate limiting / brute-force koruması için (bkz. docs/security.md)
model LoginAttempt {
  id          String     @id @default(cuid())
  email       String
  ipAddress   String?
  success     Boolean
  createdAt   DateTime   @default(now())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([email, createdAt])
  @@map("login_attempts")
}

// Gelecekteki müşteri hesapları (Market PWA / e-ticaret) için temel — FAZ 1'de
// hiçbir müşteri-facing özellik bu modele bağlı değildir.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]

  @@map("users")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  line1      String
  line2      String?
  city       String
  district   String?
  postalCode String?
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("addresses")
}

// ----------------------------------------------------------
// Katalog
// ----------------------------------------------------------

// ----------------------------------------------------------
// FAZ 2 mimari kararı — Kategori Hiyerarşisi
// FAZ 1'deki ayrı Category/SubCategory (2 seviyeli, sabit) modeli, hiçbir
// gerçek veri taşımadığı doğrulandıktan sonra (0 SubCategory kaydı, 0
// Product.subcategoryId, 0 Campaign scope=SUBCATEGORY — bkz. FAZ2 raporu
// Bölüm B) kendine-referanslı (self-referential), sınırsız derinlikte bir
// ağaca dönüştürüldü: "Bahçe > Bahçe Dekorasyonu > Saksılar" gibi 3+ seviyeli
// yapılar artık desteklenir. `path` alanı materialized-path deseniyle
// tutulur (ör. "/catA/catB/catC/") — 10.000+ ürün ölçeğinde "bu kategori
// ve tüm alt kategorileri" sorgusunu tek bir indexed `startsWith` ile,
// recursive CTE gerektirmeden yanıtlar (bkz. docs/catalog.md).
// ----------------------------------------------------------

model Category {
  id               String  @id @default(cuid())
  slug             String  @unique
  title            String
  shortDescription String?
  description      String?
  imageUrl         String?
  icon             String?
  color            String?
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)
  isFeatured       Boolean @default(false)
  seoTitle         String?
  seoDescription   String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  // Materialized path: "/<ata1Id>/<ata2Id>/.../<selfId>/". Kök kategoriler
  // için "/<selfId>/". src/lib/category-tree.ts tarafından create/move
  // sırasında hesaplanır ve alt ağaç taşındığında cascade güncellenir.
  path  String @default("/")
  depth Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products             Product[]
  banners              Banner[]
  campaigns            Campaign[]
  attributeDefinitions ProductAttributeDefinition[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

model Brand {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  logoUrl        String?
  description    String?
  website        String?
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// Uygulama katmanında zorunlu kılınan değerler (src/lib/enums.ts):
// ProductUnit: KG | ADET | LITRE | METREKARE | METRE | SET | SISE | TANE | PAKET | GRAM
// StockStatus: IN_STOCK | LOW_STOCK | OUT_OF_STOCK

model Product {
  id         String   @id @default(cuid())
  sku        String   @unique
  barcode    String?  @unique
  name       String
  slug       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])

  shortDescription String?
  description      String?

  price          Decimal // normal (liste) fiyat
  compareAtPrice Decimal? // "eski fiyat" / üstü çizili
  salePrice      Decimal? // admin tarafından elle belirlenmiş indirimli fiyat
  costPrice      Decimal? // yalnızca admin görür, maliyet analizi için

  taxRate Decimal @default(20) // KDV %

  unit           String  @default("ADET")
  weight         Float?
  dimensionsJson String? // JSON: { en, boy, derinlik } — SQLite'ta düz metin
  attributesJson String? // JSON: serbest nitelikler

  seoTitle       String?
  seoDescription String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  // Migrasyon izlenebilirliği (products.js -> DB)
  legacySourceId      String? // eski kategori id + index (ör. "baharat-0")
  legacyCategoryLabel String? // migrasyon zamanındaki orijinal kategori adı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images           ProductImage[]
  variants         ProductVariant[]
  inventory        Inventory?
  priceHistory     PriceHistory[]
  tags             ProductTag[]
  campaignProducts CampaignProduct[]
  banners          Banner[]
  attributeValues  ProductAttributeValue[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url             String
  altText         String?
  sortOrder       Int     @default(0)
  isPrimary       Boolean @default(false)
  // Bölüm 28 — "mobil görsel": ayrı bir yükleme akışı yerine, galerideki
  // MEVCUT görsellerden biri mobilde öncelikli gösterilecek şekilde
  // işaretlenebilir (isPrimary ile aynı "üründe tek tane" mantığı).
  isMobilePrimary Boolean @default(false)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // ör. "500g", "1kg", "Kırmızı"
  sku           String   @unique
  priceOverride Decimal?
  stock         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([productId])
  @@map("product_variants")
}

// ----------------------------------------------------------
// FAZ 2 — Esnek Ürün Özellikleri (Attributes)
// Bitki, hortum, tohum gibi çok farklı ürün gruplarının birbirinden tamamen
// farklı özellik setleri olabileceği için (güneş ihtiyacı, uzunluk, gramaj...)
// bu alanlar Product tablosuna hard-code edilmedi. Bunun yerine tanım (hangi
// özellik, hangi kategoride, hangi tipte) ve değer (hangi ürün, ne değer)
// ayrı tutulur — kategori bazında farklı özellik setleri desteklenir.
// ----------------------------------------------------------

model ProductAttributeDefinition {
  id          String    @id @default(cuid())
  categoryId  String? // null = tüm kategorilerde kullanılabilir (global özellik)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key         String // makine-okunur ad, ör. "gunes_ihtiyaci"
  name        String // insan-okunur ad, ör. "Güneş İhtiyacı"
  // TEXT | NUMBER | BOOLEAN | SELECT (bkz. src/lib/enums.ts)
  type        String    @default("TEXT")
  unit        String? // ör. "cm", "°C", "gün"
  optionsJson String? // SELECT tipi için seçenek listesi, JSON dizi
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  values ProductAttributeValue[]

  @@unique([categoryId, key])
  @@index([categoryId])
  @@map("product_attribute_definitions")
}

model ProductAttributeValue {
  id                    String                     @id @default(cuid())
  productId             String
  product               Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeDefinitionId String
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)
  value                 String // tüm tipler (TEXT/NUMBER/BOOLEAN/SELECT) burada metin olarak tutulur, tip attributeDefinition.type'a göre uygulama katmanında yorumlanır

  @@unique([productId, attributeDefinitionId])
  @@index([productId])
  @@index([attributeDefinitionId])
  @@map("product_attribute_values")
}

// ----------------------------------------------------------
// Stok
// ----------------------------------------------------------

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  // IN_STOCK | LOW_STOCK | OUT_OF_STOCK (bkz. src/lib/enums.ts)
  stockStatus       String   @default("IN_STOCK")
  updatedAt         DateTime @updatedAt

  movements InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id                String     @id @default(cuid())
  inventoryId       String
  inventory         Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  // RESTOCK | SALE | ADJUSTMENT | MIGRATION (bkz. src/lib/enums.ts)
  type              String
  quantityChange    Int
  resultingQuantity Int
  reason            String?
  createdByAdminId  String?
  createdByAdmin    AdminUser? @relation(fields: [createdByAdminId], references: [id])
  createdAt         DateTime   @default(now())

  @@index([inventoryId])
  @@map("inventory_movements")
}

// ----------------------------------------------------------
// Fiyat geçmişi
// ----------------------------------------------------------

model PriceHistory {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  field       String // "price" | "compareAtPrice" | "salePrice"
  oldValue    Decimal?
  newValue    Decimal?
  reason      String? // ör. "manual", "bulk:+10%", "migration"
  changedById String?
  changedBy   AdminUser? @relation(fields: [changedById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([productId])
  @@map("price_history")
}

// ----------------------------------------------------------
// Kampanya
// ----------------------------------------------------------

model Campaign {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  description   String?
  // PERCENTAGE | FIXED_AMOUNT (bkz. src/lib/enums.ts)
  discountType  String
  discountValue Decimal
  // PRODUCT | CATEGORY | GLOBAL (bkz. src/lib/enums.ts).
  // FAZ 2'de SUBCATEGORY kaldırıldı: kategoriler artık ağaç yapısında,
  // CATEGORY kapsamı seçilen kategori VE tüm alt kategorilerini otomatik
  // kapsar (bkz. src/lib/category-tree.ts, computeFinalPrice). Hiçbir
  // gerçek kampanya SUBCATEGORY kullanmıyordu (bkz. FAZ2 raporu Bölüm B).
  scope         String

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true) // manuel kapatma anahtarı

  bannerText String?
  ctaText    String?
  ctaLink    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products CampaignProduct[]
  banners  Banner[]

  @@index([startDate, endDate])
  @@map("campaigns")
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@map("campaign_products")
}

// ----------------------------------------------------------
// Banner
// ----------------------------------------------------------

model Banner {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  ctaText        String?
  ctaLink        String?
  startDate      DateTime
  endDate        DateTime
  priority       Int      @default(0)
  isActive       Boolean  @default(true)

  targetCategoryId String?
  targetCategory   Category? @relation(fields: [targetCategoryId], references: [id])
  targetProductId  String?
  targetProduct    Product?  @relation(fields: [targetProductId], references: [id])
  targetCampaignId String?
  targetCampaign   Campaign? @relation(fields: [targetCampaignId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
  @@map("banners")
}

// ----------------------------------------------------------
// Audit Log
// ----------------------------------------------------------

model AuditLog {
  id           String     @id @default(cuid())
  adminUserId  String?
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id])
  action       String // LOGIN, LOGOUT, PRODUCT_CREATE, PRODUCT_UPDATE, PRODUCT_ARCHIVE,
  // PRICE_UPDATE, CAMPAIGN_CREATE, CAMPAIGN_UPDATE,
  // BANNER_CREATE, BANNER_UPDATE, INVENTORY_UPDATE, ...
  entity       String // "Product" | "Campaign" | "Banner" | "Auth" | "Inventory" | ...
  entityId     String?
  ipAddress    String?
  metadataJson String? // JSON serileştirilmiş ek bilgi
  createdAt    DateTime   @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------
// FAZ 2 — CSV/Excel İçe Aktarma İşleri
// Her import çalıştırması bir ImportJob kaydı olarak izlenir: kaç satır
// işlendi, kaçı başarılı/hatalı/yeni/güncellenen, hata detayları (satır
// bazlı) — Bölüm 25/38 gereksinimi. Satır bazlı ayrı tablo yerine JSON
// olarak tutuldu (SQLite + mevcut ölçek için yeterli, sorgu ihtiyacı yok).
// ----------------------------------------------------------

model ImportJob {
  id       String @id @default(cuid())
  fileName String
  // PENDING | VALIDATED | IMPORTING | COMPLETED | FAILED (bkz. enums.ts)
  status   String @default("PENDING")

  totalRows    Int @default(0)
  successCount Int @default(0)
  errorCount   Int @default(0)
  createdCount Int @default(0)
  updatedCount Int @default(0)

  columnMappingJson String? // { "Ürün Adı": "name", "SKU": "sku", ... }
  errorsJson        String? // [{ row, field, message }, ...]

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime   @default(now())
  finishedAt       DateTime?

  @@index([status])
  @@map("import_jobs")
}

// ----------------------------------------------------------
// Genel Ayarlar (Bize Ulaşın, marka bilgisi vb.)
// ----------------------------------------------------------

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
