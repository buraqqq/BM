// ==========================================================
// B&M Vourla — Prisma Schema (FAZ 1)
// Veritabanı: SQLite (bkz. .env.example ve docs/database.md için
// hosted Postgres/libSQL'e geçiş notları)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------
// Kimlik & Yetkilendirme
// ----------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  // SQLite native enum desteklemez; izin verilen değerler uygulama katmanında
  // (src/lib/enums.ts + zod) zorunlu kılınır: SUPER_ADMIN | ADMIN | STAFF
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  loginAttempts  LoginAttempt[]
  auditLogs      AuditLog[]
  priceChanges   PriceHistory[]
  inventoryMoves InventoryMovement[]
  importJobs     ImportJob[]

  @@map("admin_users")
}

// Rate limiting / brute-force koruması için (bkz. docs/security.md)
model LoginAttempt {
  id          String     @id @default(cuid())
  email       String
  ipAddress   String?
  success     Boolean
  createdAt   DateTime   @default(now())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([email, createdAt])
  @@map("login_attempts")
}

// FAZ 1'de temel olarak eklenmişti, hiçbir müşteri-facing özellik bu modele
// bağlı değildi. FAZ 4A — Bölüm 1/2: gerçek müşteri hesabı/kayıt/giriş bu
// modelin üzerine inşa edildi (bkz. src/lib/auth.ts customer-credentials
// provider). `surname` alanı FAZ4A Bölüm 2 (name+surname ayrı alan) için
// eklendi — mevcut `name` alanı (opsiyonel, legacy) korunuyor, yeni kayıtlar
// hem name hem surname'i dolduruyor.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  surname      String?
  phone        String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  carts     Cart[]
  orders    Order[]
  alerts    ProductAlert[]

  @@map("users")
}

// FAZ 4A — Bölüm 6: FAZ1'den beri şemada duran ama hiç kullanılmayan (0 satır)
// Address modeli, bu fazda gerçekten kullanılmaya başlandığı için Türkiye
// adres yapısına uygun alanlarla YENİDEN TANIMLANDI (rename değil — hiçbir
// gerçek veri taşımadığı doğrulandıktan sonra, bkz. FAZ4A raporu). Sistem
// yalnızca İzmir'e kilitlenmedi: `city`/`district` serbest metin, `country`
// varsayılan "Türkiye" ama değiştirilebilir.
model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String // "Ev", "İş" vb. — kullanıcının kendi adres etiketi
  firstName    String
  lastName     String
  phone        String
  city         String // il
  district     String // ilçe
  neighborhood String? // mahalle
  addressLine  String // açık adres (sokak, no, kapı vb.)
  postalCode   String?
  country      String   @default("Türkiye")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ----------------------------------------------------------
// FAZ 3 — Bölüm 8: Ticari altyapı hazırlığı (yalnızca şema)
//
// Hedeflenen ileriki akış:
//   Ürün → Sepete Ekle → Cart → Customer → Address → Gel-Al/Kargo → Payment
//
// Bu FAZ'da ödeme/sipariş İŞLEME alınmıyor — yalnızca akışın "Ürün → Sepete
// Ekle → Cart" kısmına kadarki veri modeli, gelecekteki çalışan bir sepet/
// checkout özelliğinin üzerine doğrudan inşa edilebilmesi için baştan
// hazırlanıyor. Customer/Address adımları zaten FAZ 1'den beri var olan
// User/Address modelleriyle karşılanıyor (bkz. yukarısı) — burada yeniden
// tanımlanmadı. "Gel-Al/Kargo" ve "Payment" adımları için HENÜZ hiçbir
// model eklenmedi (bkz. docs/commerce.md — bu adımların şeması FAZ 4+'a
// bırakıldı, çünkü teslimat/ödeme yöntemi seçimi henüz netleşmedi ve
// şimdiden model eklemek tahmin/uydurma olurdu).
//
// Cart, hem giriş yapmış (userId dolu) hem de misafir (sessionToken ile,
// userId null) kullanıcıyı destekleyecek şekilde tasarlandı — bu, mevcut
// public sitenin (FAZ 1'den beri) hiçbir müşteri girişi ZORUNLU KILMAMASI
// ilkesiyle tutarlı. Şu an hiçbir API rotası veya UI bu modelleri
// okumuyor/yazmıyor — sepete ekle butonu FAZ 3'te de yalnızca WhatsApp
// siparişine yönlendiriyor (bkz. docs/commerce.md).
// ----------------------------------------------------------

model Cart {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?  @unique // misafir sepeti için (userId null olduğunda zorunlu)
  status       String   @default("ACTIVE") // ACTIVE | CONVERTED | ABANDONED (bkz. src/lib/enums.ts)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  // Ekleme anındaki birim fiyat — sepette gösterilecek fiyatın, üründe
  // sonradan yapılan bir fiyat değişikliğiyle sessizce değişmemesi için
  // (gerçek bir sepet UI'ı eklendiğinde "fiyat değişti" uyarısı bu alanla
  // karşılaştırılarak verilebilir). Şimdilik hiçbir kod bu alanı okumuyor.
  unitPriceAtAdd Decimal
  createdAt      DateTime @default(now())

  @@unique([cartId, productId])
  @@index([cartId])
  // FAZ 4A — Bölüm 28: productId üzerinde de index — "bu ürün kaç sepette
  // var" gibi gelecekteki admin sorguları ve CASCADE silme performansı için.
  @@index([productId])
  @@map("cart_items")
}

// ----------------------------------------------------------
// ----------------------------------------------------------
// FAZ 4C — Sipariş (Order)
//
// "Cart → Checkout Validation → Order Creation → Inventory Update" zincirinin
// son halkası. Gerçek ödeme sağlayıcısı YOK (bu fazın kesin sınırı): Order
// oluşturulur, paymentStatus "PENDING" başlar. Tasarım kararları:
//  - Address doğrudan kullanılmaz; sipariş anındaki adres OrderAddressSnapshot'a kopyalanır.
//  - OrderItem ürünün değişebilir alanlarını (ad/SKU/fiyat) snapshot saklar; productId
//    referansı "mümkünse korunur" (onDelete: SetNull).
//  - orderNumber tahmin edilmesi zor rastgele referans (BM-XXXXXXXX); @unique.
//  - cartId (unique) kaynak sepeti işaretler: idempotency + converted-cart bütünlüğü.
//  - Durum/ödeme değerleri enums.ts'te (ORDER_STATUSES / PAYMENT_STATUSES).
// ----------------------------------------------------------

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  cartId          String?  @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("PENDING")
  paymentStatus   String   @default("PENDING")
  deliveryMethod  String
  currency        String   @default("TRY")
  subtotal        Decimal
  discount        Decimal  @default(0)
  shippingAmount  Decimal  @default(0)
  shippingComputed Boolean @default(false)
  shippingNote    String?
  total           Decimal
  customerNote    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           OrderItem[]
  addressSnapshot OrderAddressSnapshot?
  statusHistory   OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal
  lineTotal   Decimal
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderAddressSnapshot {
  id           String  @id @default(cuid())
  orderId      String  @unique
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String
  city         String
  district     String
  neighborhood String?
  addressLine  String
  postalCode   String?
  country      String
  createdAt    DateTime @default(now())

  @@map("order_address_snapshots")
}

// FAZ 4C — Bölüm M: sipariş durum geçmişi. Müşterinin kendi siparişinin
// yaşam döngüsünü görebilmesi için ayrı, müşteri-güvenli zaman çizelgesi.
// Admin "kim/IP" bilgisi AuditLog'da (Bölüm L) tutulur; iki kaygı ayrı.
model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// Katalog
// ----------------------------------------------------------

// ----------------------------------------------------------
// FAZ 2 mimari kararı — Kategori Hiyerarşisi
// FAZ 1'deki ayrı Category/SubCategory (2 seviyeli, sabit) modeli, hiçbir
// gerçek veri taşımadığı doğrulandıktan sonra (0 SubCategory kaydı, 0
// Product.subcategoryId, 0 Campaign scope=SUBCATEGORY — bkz. FAZ2 raporu
// Bölüm B) kendine-referanslı (self-referential), sınırsız derinlikte bir
// ağaca dönüştürüldü: "Bahçe > Bahçe Dekorasyonu > Saksılar" gibi 3+ seviyeli
// yapılar artık desteklenir. `path` alanı materialized-path deseniyle
// tutulur (ör. "/catA/catB/catC/") — 10.000+ ürün ölçeğinde "bu kategori
// ve tüm alt kategorileri" sorgusunu tek bir indexed `startsWith` ile,
// recursive CTE gerektirmeden yanıtlar (bkz. docs/catalog.md).
// ----------------------------------------------------------

model Category {
  id               String  @id @default(cuid())
  slug             String  @unique
  title            String
  shortDescription String?
  description      String?
  imageUrl         String?
  icon             String?
  color            String?
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)
  isFeatured       Boolean @default(false)
  seoTitle         String?
  seoDescription   String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  // Materialized path: "/<ata1Id>/<ata2Id>/.../<selfId>/". Kök kategoriler
  // için "/<selfId>/". src/lib/category-tree.ts tarafından create/move
  // sırasında hesaplanır ve alt ağaç taşındığında cascade güncellenir.
  path  String @default("/")
  depth Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products             Product[]
  banners              Banner[]
  campaigns            Campaign[]
  attributeDefinitions ProductAttributeDefinition[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

model Brand {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  logoUrl        String?
  description    String?
  website        String?
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// Uygulama katmanında zorunlu kılınan değerler (src/lib/enums.ts):
// ProductUnit: KG | ADET | LITRE | METREKARE | METRE | SET | SISE | TANE | PAKET | GRAM
// StockStatus: IN_STOCK | LOW_STOCK | OUT_OF_STOCK

model Product {
  id         String   @id @default(cuid())
  sku        String   @unique
  barcode    String?  @unique
  name       String
  slug       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])

  shortDescription String?
  description      String?

  price          Decimal // normal (liste) fiyat
  compareAtPrice Decimal? // "eski fiyat" / üstü çizili
  salePrice      Decimal? // admin tarafından elle belirlenmiş indirimli fiyat
  costPrice      Decimal? // yalnızca admin görür, maliyet analizi için

  taxRate Decimal @default(20) // KDV %

  unit           String  @default("ADET")
  weight         Float?
  dimensionsJson String? // JSON: { en, boy, derinlik } — SQLite'ta düz metin
  attributesJson String? // JSON: serbest nitelikler

  seoTitle       String?
  seoDescription String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  // Migrasyon izlenebilirliği (products.js -> DB)
  legacySourceId      String? // eski kategori id + index (ör. "baharat-0")
  legacyCategoryLabel String? // migrasyon zamanındaki orijinal kategori adı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images           ProductImage[]
  variants         ProductVariant[]
  inventory        Inventory?
  priceHistory     PriceHistory[]
  tags             ProductTag[]
  campaignProducts CampaignProduct[]
  banners          Banner[]
  attributeValues  ProductAttributeValue[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  alerts           ProductAlert[]

  @@index([categoryId])
  @@index([isActive])
  @@index([brandId])
  // "name" üzerindeki bu index yalnızca sıralama (ORDER BY name) ve tam/
  // önek eşleşmeleri için işe yarar — admin aramasının kullandığı
  // `contains` (alt-dize) sorgusu SQLite'ta bu türden bir B-tree index'i
  // KULLANAMAZ. 10.000+ ürün ölçeğinde gerçek "içeren" arama performansı
  // için SQLite FTS5 sanal tablosuna geçiş gerekecektir (bkz. docs/catalog.md
  // performans notu) — bu FAZ2 kapsamında yapılmadı, bilinen bir sınırdır.
  @@index([name])
  @@map("products")
}

model ProductImage {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url             String
  altText         String?
  sortOrder       Int     @default(0)
  isPrimary       Boolean @default(false)
  // Bölüm 28 — "mobil görsel": ayrı bir yükleme akışı yerine, galerideki
  // MEVCUT görsellerden biri mobilde öncelikli gösterilecek şekilde
  // işaretlenebilir (isPrimary ile aynı "üründe tek tane" mantığı).
  isMobilePrimary Boolean @default(false)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // ör. "500g", "1kg", "Kırmızı"
  sku           String   @unique
  priceOverride Decimal?
  stock         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([productId])
  @@map("product_variants")
}

// ----------------------------------------------------------
// FAZ 2 — Esnek Ürün Özellikleri (Attributes)
// Bitki, hortum, tohum gibi çok farklı ürün gruplarının birbirinden tamamen
// farklı özellik setleri olabileceği için (güneş ihtiyacı, uzunluk, gramaj...)
// bu alanlar Product tablosuna hard-code edilmedi. Bunun yerine tanım (hangi
// özellik, hangi kategoride, hangi tipte) ve değer (hangi ürün, ne değer)
// ayrı tutulur — kategori bazında farklı özellik setleri desteklenir.
// ----------------------------------------------------------

model ProductAttributeDefinition {
  id          String    @id @default(cuid())
  categoryId  String? // null = tüm kategorilerde kullanılabilir (global özellik)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key         String // makine-okunur ad, ör. "gunes_ihtiyaci"
  name        String // insan-okunur ad, ör. "Güneş İhtiyacı"
  // TEXT | NUMBER | BOOLEAN | SELECT (bkz. src/lib/enums.ts)
  type        String    @default("TEXT")
  unit        String? // ör. "cm", "°C", "gün"
  optionsJson String? // SELECT tipi için seçenek listesi, JSON dizi
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  values ProductAttributeValue[]

  @@unique([categoryId, key])
  @@index([categoryId])
  @@map("product_attribute_definitions")
}

model ProductAttributeValue {
  id                    String                     @id @default(cuid())
  productId             String
  product               Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeDefinitionId String
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)
  value                 String // tüm tipler (TEXT/NUMBER/BOOLEAN/SELECT) burada metin olarak tutulur, tip attributeDefinition.type'a göre uygulama katmanında yorumlanır

  @@unique([productId, attributeDefinitionId])
  @@index([productId])
  @@index([attributeDefinitionId])
  @@map("product_attribute_values")
}

// ----------------------------------------------------------
// Stok
// ----------------------------------------------------------

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  // IN_STOCK | LOW_STOCK | OUT_OF_STOCK (bkz. src/lib/enums.ts)
  stockStatus       String   @default("IN_STOCK")
  updatedAt         DateTime @updatedAt

  movements InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id                String     @id @default(cuid())
  inventoryId       String
  inventory         Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  // RESTOCK | SALE | ADJUSTMENT | MIGRATION (bkz. src/lib/enums.ts)
  type              String
  quantityChange    Int
  resultingQuantity Int
  reason            String?
  createdByAdminId  String?
  createdByAdmin    AdminUser? @relation(fields: [createdByAdminId], references: [id])
  createdAt         DateTime   @default(now())

  @@index([inventoryId])
  @@map("inventory_movements")
}

// ----------------------------------------------------------
// Fiyat geçmişi
// ----------------------------------------------------------

model PriceHistory {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  field       String // "price" | "compareAtPrice" | "salePrice"
  oldValue    Decimal?
  newValue    Decimal?
  reason      String? // ör. "manual", "bulk:+10%", "migration"
  changedById String?
  changedBy   AdminUser? @relation(fields: [changedById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([productId])
  @@map("price_history")
}

// ----------------------------------------------------------
// Kampanya
// ----------------------------------------------------------

model Campaign {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  description   String?
  // PERCENTAGE | FIXED_AMOUNT (bkz. src/lib/enums.ts)
  discountType  String
  discountValue Decimal
  // PRODUCT | CATEGORY | GLOBAL (bkz. src/lib/enums.ts).
  // FAZ 2'de SUBCATEGORY kaldırıldı: kategoriler artık ağaç yapısında,
  // CATEGORY kapsamı seçilen kategori VE tüm alt kategorilerini otomatik
  // kapsar (bkz. src/lib/category-tree.ts, computeFinalPrice). Hiçbir
  // gerçek kampanya SUBCATEGORY kullanmıyordu (bkz. FAZ2 raporu Bölüm B).
  scope         String

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true) // manuel kapatma anahtarı

  bannerText String?
  ctaText    String?
  ctaLink    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products CampaignProduct[]
  banners  Banner[]

  @@index([startDate, endDate])
  @@map("campaigns")
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@map("campaign_products")
}

// ----------------------------------------------------------
// Banner
// ----------------------------------------------------------

model Banner {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  ctaText        String?
  ctaLink        String?
  startDate      DateTime
  endDate        DateTime
  priority       Int      @default(0)
  isActive       Boolean  @default(true)

  targetCategoryId String?
  targetCategory   Category? @relation(fields: [targetCategoryId], references: [id])
  targetProductId  String?
  targetProduct    Product?  @relation(fields: [targetProductId], references: [id])
  targetCampaignId String?
  targetCampaign   Campaign? @relation(fields: [targetCampaignId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
  @@map("banners")
}

// ----------------------------------------------------------
// Audit Log
// ----------------------------------------------------------

model AuditLog {
  id           String     @id @default(cuid())
  adminUserId  String?
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id])
  action       String // LOGIN, LOGOUT, PRODUCT_CREATE, PRODUCT_UPDATE, PRODUCT_ARCHIVE,
  // PRICE_UPDATE, CAMPAIGN_CREATE, CAMPAIGN_UPDATE,
  // BANNER_CREATE, BANNER_UPDATE, INVENTORY_UPDATE, ...
  entity       String // "Product" | "Campaign" | "Banner" | "Auth" | "Inventory" | ...
  entityId     String?
  ipAddress    String?
  metadataJson String? // JSON serileştirilmiş ek bilgi
  createdAt    DateTime   @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------
// FAZ 2 — CSV/Excel İçe Aktarma İşleri
// Her import çalıştırması bir ImportJob kaydı olarak izlenir: kaç satır
// işlendi, kaçı başarılı/hatalı/yeni/güncellenen, hata detayları (satır
// bazlı) — Bölüm 25/38 gereksinimi. Satır bazlı ayrı tablo yerine JSON
// olarak tutuldu (SQLite + mevcut ölçek için yeterli, sorgu ihtiyacı yok).
// ----------------------------------------------------------

model ImportJob {
  id       String @id @default(cuid())
  fileName String
  // PENDING | VALIDATED | IMPORTING | COMPLETED | FAILED (bkz. enums.ts)
  status   String @default("PENDING")

  totalRows    Int @default(0)
  successCount Int @default(0)
  errorCount   Int @default(0)
  createdCount Int @default(0)
  updatedCount Int @default(0)

  columnMappingJson String? // { "Ürün Adı": "name", "SKU": "sku", ... }
  errorsJson        String? // [{ row, field, message }, ...]

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime   @default(now())
  finishedAt       DateTime?

  @@index([status])
  @@map("import_jobs")
}

// ----------------------------------------------------------
// Genel Ayarlar (Bize Ulaşın, marka bilgisi vb.)
// ----------------------------------------------------------

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
// ----------------------------------------------------------
// FAZ 5 — Gelir Ortaklığı (Affiliate) ürünleri
//
// Tasarım motoru (AI Garden Designer), iç envanterde OLMAYAN ama tasarımın
// tamamlayıcısı olan ürünleri (canlı bitki, toprak, saksı, otomatik sulama,
// bahçe mobilyası vb.) "affiliate" olarak önerebilir. Bu ürünler AYRI bir
// tabloda tutulur ki Product tablosunun 257 aktif / 260 toplam baseline'ı
// değişmesin (iç envanter ile dış/gelir-ortaklığı kataloğu ayrı kaygılardır).
// `affiliateUrl` gerçek partner bağlantısını, `vendor` satıcıyı tutar.
// ----------------------------------------------------------

model AffiliateProduct {
  id            String   @id @default(cuid())
  name          String
  vendor        String
  affiliateUrl  String
  commissionRate Decimal? // % komisyon oranÄ± (Ã¶r. 6.5)
  // Tasarım BOM bileşeni türü: bitki | toprak | saksi | sulama | mobilya |
  // aydinlatma | dekor | gubre | alet (bkz. ai-designer-logic.ts)
  category      String
  estimatedPrice Decimal?
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@map("affiliate_products")
}

// ----------------------------------------------------------
// FAZ 9 — Stok & Fiyat Alarmları.
//
// Kullanıcılar bir ürün için stok/fiyat bildirimi kurabilir. Alert hem
// STOCK_RESTOCK/BACK_IN_STOCK (stoğa geri gelme) hem PRICE_DROP (fiyatın
// hedef fiyatın altına inmesi) için kullanılır. alertType String tutulur
// (SQLite native enum yok; izin verilen değerler src/lib/enums.ts -> ALERT_TYPES).
// targetPrice yalnızca PRICE_DROP için anlamlıdır (opsiyonel).
// isTriggered: alarm tetiklendiğinde true olur — aynı alarmın tekrar tekrar
// tetiklenmesini önler.
// ----------------------------------------------------------

model ProductAlert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  alertType   String // STOCK_RESTOCK | PRICE_DROP | BACK_IN_STOCK (bkz. enums.ts)
  targetPrice Decimal? // PRICE_DROP hedef fiyatı (TL)
  isTriggered Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([productId, alertType, isTriggered])
  @@map("product_alerts")
}
